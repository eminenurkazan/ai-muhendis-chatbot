# Bu örnek dosyada parola bulunmaz. Gerçek değeri yerel ortamda tut.
# Yerel SQL Server Express örneği: .\SQLEXPRESS
# Bağlantıyı mssql/verify_sqlexpress.ps1 ile test edebilirsin.
# Uygulama veritabanı hazırdır. verify_sqlexpress.ps1 ayrı olarak master bağlantısını sınar.
MSSQL_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=.\SQLEXPRESS;Database=ServisMasasiApp;Trusted_Connection=Yes;
