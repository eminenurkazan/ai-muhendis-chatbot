# Bu örnek dosyada parola bulunmaz. Gerçek değeri yerel ortamda tut.
# Yerel SQL Server Express örneği: .\SQLEXPRESS
# Bağlantıyı mssql/verify_sqlexpress.ps1 ile test edebilirsin.
# Uygulama veritabanı hazırdır. verify_sqlexpress.ps1 ayrı olarak master bağlantısını sınar.
MSSQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=.\SQLEXPRESS;Database=ServisMasasiApp;Trusted_Connection=Yes;Encrypt=Yes;TrustServerCertificate=Yes;

# Gerçek rastgele anahtarı yalnızca .env içinde sakla; bu örnek değer kullanılmaz.
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# Bilgi tabanı için PostgreSQL bağlantısını yerel .env dosyasında tanımla.
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
